generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model Qiraa {
  id        Int         @id
  shortName String
  fullName  String
  region    QiraaRegion
  riwayat   Riwaya[]
}

model Riwaya {
  id        Int      @id
  shortName String
  fullName  String
  qiraaId   Int
  mushafs   Mushaf[]
  qiraa     Qiraa    @relation(fields: [qiraaId], references: [id])
  tariqs    Tariq[]

  @@index([qiraaId])
}

model Tariq {
  id       Int    @id
  name     String
  riwayaId Int
  riwaya   Riwaya @relation(fields: [riwayaId], references: [id])

  @@index([riwayaId])
}

model Mushaf {
  id          Int     @id
  name        String
  description String?
  bismillah   String?
  riwayaId    Int
  riwaya      Riwaya  @relation(fields: [riwayaId], references: [id])

  @@index([riwayaId])
}

model Surah {
  id              Int                 @id
  number          Int                 @unique
  name            String
  codedName       String?
  translatedName  String?
  numberOfAyahs   Int
  firstPage       Int
  lastPage        Int
  firstJuz        Int
  revelationType  SurahRevelationType
  revelationOrder Int
  ayahs           Ayah[]
}

model Ayah {
  id           Int          @id
  number       Int
  surahNumber  Int
  text         String
  pageNumber   Int
  juz          Int
  hizb         Int
  manzil       Int
  ruku         Int
  marker       String
  numberInHafs Int[]
  surah        Surah        @relation(fields: [surahNumber], references: [number])
  annotations  Annotation[]

  @@unique([surahNumber, number])
  @@index([surahNumber])
  @@index([pageNumber])
  @@index([juz])
}

model Annotation {
  id        String   @id @default(cuid())
  userId    String
  ayahId    Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  ayah Ayah @relation(fields: [ayahId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ayahId])
  @@index([userId, ayahId])
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  name            String?
  emailVerifiedAt DateTime?
  image           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  accounts        Account[]
  childProfiles   ChildProfile[]
  sessions        Session[]
  annotations     Annotation[]
}

model Account {
  id                String          @id @default(cuid())
  userId            String
  provider          AccountProvider
  providerAccountId String
  passwordHash      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ChildProfile {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum QiraaRegion {
  madinah
  makkah
  basrah
  damascus
  kufa
}

enum SurahRevelationType {
  meccan
  medinan
}

enum AccountProvider {
  credentials
  google
}
