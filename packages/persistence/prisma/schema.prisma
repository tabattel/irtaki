generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model Qiraa {
  id        Int         @id
  shortName String
  fullName  String
  region    QiraaRegion
  riwayat   Riwaya[]
}

model Riwaya {
  id        Int       @id
  shortName String
  fullName  String
  qiraaId   Int
  mushafs   Mushaf[]
  qiraa     Qiraa     @relation(fields: [qiraaId], references: [id])
  tariqs    Tariq[]
  reciters  Reciter[]

  @@index([qiraaId])
}

model Tariq {
  id       Int    @id
  name     String
  riwayaId Int
  riwaya   Riwaya @relation(fields: [riwayaId], references: [id])

  @@index([riwayaId])
}

model Mushaf {
  id          Int     @id
  name        String
  description String?
  bismillah   String?
  riwayaId    Int
  riwaya      Riwaya  @relation(fields: [riwayaId], references: [id])

  @@index([riwayaId])
}

model Surah {
  id              Int                 @id
  number          Int                 @unique
  name            String
  codedName       String?
  translatedName  String?
  numberOfAyahs   Int
  firstPage       Int
  lastPage        Int
  firstJuz        Int
  revelationType  SurahRevelationType
  revelationOrder Int
  ayahs           Ayah[]
}

model Ayah {
  id           Int          @id
  number       Int
  surahNumber  Int
  text         String
  pageNumber   Int
  juz          Int
  hizb         Int
  manzil       Int
  ruku         Int
  marker       String
  numberInHafs Int[]
  surah        Surah        @relation(fields: [surahNumber], references: [number])
  annotations  Annotation[]
  audioTracks  AudioTrack[]

  @@unique([surahNumber, number])
  @@index([surahNumber])
  @@index([pageNumber])
  @@index([juz])
}

model Reciter {
  id         String       @id
  name       String
  arabicName String
  riwayaId   Int
  riwaya     Riwaya       @relation(fields: [riwayaId], references: [id])
  tracks     AudioTrack[]

  @@index([riwayaId])
}

model AudioTrack {
  id         String      @id @default(cuid())
  ayahId     Int
  reciterId  String
  format     AudioFormat
  durationMs Int?
  sourceKey  String
  createdAt  DateTime    @default(now())

  ayah    Ayah    @relation(fields: [ayahId], references: [id], onDelete: Cascade)
  reciter Reciter @relation(fields: [reciterId], references: [id], onDelete: Cascade)

  @@unique([ayahId, reciterId, format])
  @@index([ayahId])
  @@index([reciterId])
}

enum AudioFormat {
  opus
}

model Annotation {
  id        String   @id @default(cuid())
  userId    String
  ayahId    Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  ayah Ayah @relation(fields: [ayahId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ayahId])
  @@index([userId, ayahId])
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  name            String?
  emailVerifiedAt DateTime?
  image           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  accounts        Account[]
  childProfiles   ChildProfile[]
  sessions        Session[]
  annotations     Annotation[]
  learners        Learner[]
}

model Account {
  id                String          @id @default(cuid())
  userId            String
  provider          AccountProvider
  providerAccountId String
  passwordHash      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ChildProfile {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  learner   Learner?

  @@index([userId])
}

enum QiraaRegion {
  madinah
  makkah
  basrah
  damascus
  kufa
}

enum SurahRevelationType {
  meccan
  medinan
}

enum AccountProvider {
  credentials
  google
}

model Learner {
  id              String        @id @default(cuid())
  userId          String
  childProfileId  String?       @unique
  name            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  childProfile    ChildProfile? @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  goals           Goal[]
  activities      Activity[]
  progress        ProgressRecord[]

  @@index([userId])
}

model Goal {
  id                   String            @id @default(cuid())
  learnerId            String
  parentGoalId         String?
  title                String
  description          String?
  action               GoalAction
  quantity             Decimal           @db.Decimal(10, 2)
  unit                 ProgressUnit
  frequencyCount       Int
  frequencyPeriod      FrequencyPeriod
  intervalDays         Int?
  weekday              Weekday?
  startDate            DateTime
  endDate              DateTime?
  status               GoalStatus        @default(active)
  notificationEnabled  Boolean           @default(false)
  notificationTime     String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  learner              Learner           @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  parentGoal            Goal?             @relation("GoalHierarchy", fields: [parentGoalId], references: [id], onDelete: SetNull)
  subGoals             Goal[]            @relation("GoalHierarchy")
  target               GoalTarget?
  activities            Activity[]
  progress              ProgressRecord[]

  @@index([learnerId])
  @@index([parentGoalId])
  @@index([status])
  @@index([startDate, endDate])
}

model GoalTarget {
  id          String          @id @default(cuid())
  goalId      String          @unique
  scope       GoalTargetScope
  startValue  String?
  endValue    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  goal        Goal            @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([scope])
}

model Activity {
  id          String          @id @default(cuid())
  learnerId   String
  goalId      String?
  action      GoalAction
  startedAt   DateTime
  endedAt     DateTime?
  durationSec Int?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime         @updatedAt

  learner     Learner         @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  goal        Goal?           @relation(fields: [goalId], references: [id], onDelete: SetNull)
  result      ActivityResult?
  progress    ProgressRecord[]

  @@index([learnerId])
  @@index([goalId])
  @@index([startedAt])
}

model ActivityResult {
  id          String               @id @default(cuid())
  activityId  String               @unique
  status      ActivityResultStatus
  quantity    Decimal              @db.Decimal(10, 2)
  unit        ProgressUnit
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  activity    Activity             @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model ProgressRecord {
  id          String          @id @default(cuid())
  learnerId   String
  goalId      String?
  activityId  String?
  recordedAt  DateTime        @default(now())
  quantity    Decimal         @db.Decimal(10, 2)
  unit        ProgressUnit
  createdAt   DateTime        @default(now())

  learner     Learner         @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  goal        Goal?           @relation(fields: [goalId], references: [id], onDelete: SetNull)
  activity    Activity?       @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([learnerId, recordedAt])
  @@index([goalId, recordedAt])
  @@index([activityId])
}

enum GoalAction {
  read
  listen
  recite
  memorize
  revise
  tajwid
  tadabbur
  talkin
  tathbit
}

enum ProgressUnit {
  quran
  surah
  ayah
  page
  juz
  hizb
  nisf
  roboa
}

enum FrequencyPeriod {
  day
  week
  month
}

enum Weekday {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

enum GoalStatus {
  draft
  active
  paused
  completed
  cancelled
  archived
}

enum GoalTargetScope {
  quran
  surah
  juz
  hizb
  nisf
  roboa
  page
  page_range
  ayah
  ayah_range
}

enum ActivityResultStatus {
  completed
  partial
  failed
  skipped
}
