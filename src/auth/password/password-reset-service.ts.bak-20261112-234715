import { EmailSender } from "../email/email-sender";
import type { UserRepository, PasswordResetTokenRepository } from "@irtaki/persistence";
import { PasswordHasher } from "./password-hasher";
import { SessionService } from "../session/session-service";

export class PasswordResetService {
  constructor(
    private readonly userRepository = new UserRepository(),
    private readonly passwordResetTokenRepository = new PasswordResetTokenRepository(),
    private readonly accountRepository = new AccountRepository(),
    private readonly sessionService = new SessionService(),
    private readonly emailSender: EmailSender,
    private readonly hasher = new PasswordHasher()
  ) {}

  async requestPasswordReset({ email, origin }: { email: string; origin: string }): Promise<void> {
    const normalizedEmail = normalizeEmail(email);
    const user = await this.userRepository.findByEmail(normalizedEmail);

    if (!user || !user.accounts.some(account => account.provider === "credentials")) {
      return; // succès silencieux si email inconnu ou sans compte credentials
    }

    await this.passwordResetTokenRepository.deleteByUserId(user.id);

    const token = randomBytes(32).toString('hex');
    const tokenHash = createHash('sha256').update(token).digest('hex');
    const expiresAt = new Date(Date.now() + 1 * 60 * 60 * 1000); // 1 heure

    await this.passwordResetTokenRepository.create({ userId: user.id, tokenHash, expiresAt });

    const resetUrl = `${origin}/reinitialiser-mot-de-passe?token=${token}`;

    await this.emailSender.sendPasswordReset({ to: normalizedEmail, resetUrl });
  }

  async resetPassword({ token, password }: { token: string; password: string }): Promise<void> {
    const tokenHash = createHash('sha256').update(token).digest('hex');
    const passwordResetToken = await this.passwordResetTokenRepository.findByTokenHash(tokenHash);

    if (!passwordResetToken || passwordResetToken.usedAt) {
      throw new Error("INVALID_RESET_TOKEN");
    }

    if (passwordResetToken.expiresAt < new Date()) {
      throw new Error("EXPIRED_RESET_TOKEN");
    }

    if (!isValidPassword(password)) {
      throw new Error("WEAK_PASSWORD");
    }

    const passwordHash = await this.hasher.hash(password);

    await this.accountRepository.updateCredentialsPassword(passwordResetToken.user.email, passwordHash);

    await this.passwordResetTokenRepository.markUsed(passwordResetToken.id);
    await this.sessionService.revokeAllSessionsForUser(passwordResetToken.userId);
    await this.passwordResetTokenRepository.deleteExpired(new Date());
  }
}
